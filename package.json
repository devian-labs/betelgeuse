{
  "name": "betelgeuse-monorepo",
  "private": true,
  "description": "Block-based notes on plain Markdown + git, open to AI agents over MCP",
  "license": "MIT",
  "homepage": "https://betelgeuse.devianlabs.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/devian-labs/betelgeuse.git"
  },
  "bugs": {
    "url": "https://github.com/devian-labs/betelgeuse/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "app": "npm run app -w @betelgeuse/desktop",
    "build:app": "npm run mcp:build && npm run build:app -w @betelgeuse/desktop",
    "lander": "npm run dev -w @betelgeuse/lander",
    "mcp:build": "npm run build -w betelgeuse-mcp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "version:set": "node scripts/set-version.mjs"
  }
}
