# From the GitHub App you register for this site (see README.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's URL slug: github.com/apps/<slug>
NEXT_PUBLIC_GITHUB_APP_SLUG=
# Seals the session cookie. Any long random string: openssl rand -base64 32
SESSION_SECRET=
# Production only: this deployment's address, such as https://app.betelgeuse.pro
APP_URL=
# Optional: Unsplash Access Key for cover photo search
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=
