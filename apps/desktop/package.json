{
  "name": "@betelgeuse/desktop",
  "private": true,
  "version": "0.5.2",
  "description": "The Betelgeuse desktop app (Tauri + React)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/notices.mjs && vite",
    "build": "node scripts/notices.mjs && tsc --noEmit && vite build",
    "tauri": "tauri",
    "app": "npm run mcp:build && tauri dev",
    "mcp:build": "npm run build -w betelgeuse-mcp",
    "test": "node --import tsx --test tests/*.test.mjs && cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "build:app": "tauri build",
    "typecheck": "tsc --noEmit",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@betelgeuse/ui": "*",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tiptap/y-tiptap": "^3.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
