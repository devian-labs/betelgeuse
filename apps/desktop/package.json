{
  "name": "@betelgeuse/desktop",
  "private": true,
  "version": "0.5.1",
  "description": "The Betelgeuse desktop app (Tauri + React)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/notices.mjs && vite",
    "build": "node scripts/notices.mjs && tsc --noEmit && vite build",
    "tauri": "tauri",
    "app": "npm run mcp:build && tauri dev",
    "mcp:build": "npm run build -w betelgeuse-mcp",
    "test": "node --import tsx --test tests/*.test.mjs && cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "build:app": "tauri build",
    "typecheck": "tsc --noEmit",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-collaboration": "^3.32.2",
    "@tiptap/extension-details": "^3.32.2",
    "@tiptap/extension-drag-handle": "^3.32.2",
    "@tiptap/extension-drag-handle-react": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-node-range": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "@tiptap/y-tiptap": "^3.0.12",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unicode-emoji-json": "^0.9.0",
    "y-protocols": "^1.0.7",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@betelgeuse/plugin-api": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
